{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delegate",
  "version": "0.2.3",
  "identifier": "com.raphaelmitas.delegate",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Delegate",
        "label": "main",
        "width": 420,
        "height": 580,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "resizable": true,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
